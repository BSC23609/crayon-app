# Set these in Vercel > Project > Settings > Environment Variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/crayon_sales?sslmode=require
SECRET_KEY=any-long-random-text
ADMIN_EMAIL=you@crayonroofings.com
ADMIN_PASSWORD=first-login-password
# Forgot-password emails (Microsoft 365 via Graph; Azure app needs Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=info@crayonroofings.com
